# Models go through litellm, so any provider it supports works.
# Default setup: DeepSeek V4.1 Flash with thinking off (tau2 does not send the model's
# reasoning back between tool calls, which DeepSeek's thinking mode requires).
DEEPSEEK_API_KEY=
RAS_AGENT_LLM=deepseek/deepseek-flash
RAS_USER_LLM=deepseek/deepseek-flash
RAS_LLM_ARGS='{"extra_body": {"thinking": {"type": "disabled"}}}'

# Other OpenAI-compatible endpoints: use "openai/<model>" and set
# OPENAI_API_KEY=
# OPENAI_API_BASE=
